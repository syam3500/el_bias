# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Static analysis & test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────────────────────
# R / RStudio / Quarto
# ─────────────────────────────────────────────────────────────────────────────
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
*-Ex.R

# renv local library (lockfile is committed; library is not)
renv/library/
renv/staging/
renv/python/

# Quarto auto-generated assets
/_site/
/_freeze/
/.quarto/
/_book/
*_files/
*_cache/

# ─────────────────────────────────────────────────────────────────────────────
# LaTeX (manuscript / thesis build artefacts)
# ─────────────────────────────────────────────────────────────────────────────
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.spl
*.synctex.gz
*.toc
*.vrb
*.dvi
*.ps
*.pdf

# Keep the rendered manuscript / thesis PDFs explicitly when needed
!docs/*.pdf
!results/figures/*.pdf

# ─────────────────────────────────────────────────────────────────────────────
# Operating system junk
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
ehthumbs.db
Icon?
$RECYCLE.BIN/

# IDE / editor metadata
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# Project-specific
# ─────────────────────────────────────────────────────────────────────────────
# Large model artefacts (regenerated by notebooks 04–06)
# *.joblib  — committed directly to models/
# !models/*.joblib
*.pkl
!models/*.joblib
*.h5

# SLURM job logs from cluster runs
slurm-*.out
*.err

# Local-only directories (private notes, full Quarto renders, etc.)
.local_full_render/
*.bak
*.bak[0-9]
